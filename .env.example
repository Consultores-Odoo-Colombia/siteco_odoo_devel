# =============================================================================
# Coolify (Hetzner self-hosted) — Odoo 18 CE + PostgreSQL 16 + Redis 7
# =============================================================================
# HOW TO USE WITH COOLIFY:
#   1. In Coolify UI: create a new "Docker Compose" resource pointing to this
#      repo+branch. Coolify will read docker-compose.yml.
#   2. Copy each KEY=VALUE below into Coolify → Project → Environment Variables.
#      Coolify auto-generates the .env on the server at deploy time and feeds
#      it to compose (env_file: .env).
#   3. DO NOT configure a "Domain" in the Coolify UI for this service — the
#      Traefik labels in docker-compose.yml already handle routing (web on
#      :8069 + websocket /websocket on :8072). Configuring it in the UI would
#      create duplicate/colliding labels.
#   4. Point your DNS A-record (e.g. mypets.siteco-soluciones.online) to the
#      Hetzner server's public IP before the first deploy so Let's Encrypt can
#      issue the cert.
#
# Keep this file in the repo as REFERENCE ONLY — never commit a real .env with
# secrets. The repo's .gitignore ignores all dotfiles by default; to commit
# THIS file as documentation, add `!.env.example` to .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Service identification (used by Traefik labels in docker-compose.yml)
# -----------------------------------------------------------------------------
SERVICE_NAME=mypets
DOMAIN=mypets.siteco-soluciones.online
ODOO_IMAGE=ghcr.io/juanca2918/odoo18-ce:siteco-odoo-v1.0

# -----------------------------------------------------------------------------
# PostgreSQL
# IMPORTANT: never use 'postgres' as POSTGRES_USER. Odoo aborts with
# "Using the database user 'postgres' is a security risk, aborting."
# Pick any other name (typically 'odoo'). Postgres creates that role as
# owner of POSTGRES_DB on the first init of the db-data volume.
#
# COOLIFY TIP: instead of writing a plain password, you can use
#   POSTGRES_PASSWORD=$SERVICE_PASSWORD_POSTGRES
# and Coolify will auto-generate a 64-char random password and inject it.
# Same trick for ADMIN_PASSWORD ($SERVICE_PASSWORD_ADMIN).
# -----------------------------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=mypetsdb

# -----------------------------------------------------------------------------
# Odoo → Postgres connection
# Must match POSTGRES_USER / POSTGRES_PASSWORD above.
# DBNAME should equal POSTGRES_DB so the entrypoint finds the DB on first run.
# -----------------------------------------------------------------------------
DB_USER=odoo
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DBNAME=mypetsdb
DBFILTER=^mypetsdb$

# -----------------------------------------------------------------------------
# Odoo master password (used in /web/database manager)
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# Redis session store prefix (typically = SERVICE_NAME)
# -----------------------------------------------------------------------------
ODOO_SESSION_REDIS_PREFIX=mypets

# -----------------------------------------------------------------------------
# Odoo runtime tuning (Hetzner dedicated server — adjust to CPU/RAM available)
# -----------------------------------------------------------------------------
WORKERS=4
MAX_CRON_THREADS=2
LIMIT_MEMORY_SOFT=2147483648
LIMIT_MEMORY_HARD=2684354560
# OJO: backup/restore/duplicar desde el gestor de BD son peticiones HTTP largas.
# Con 60/120s el worker mata la operación y el ZIP queda corrupto. Súbelos según
# el tamaño de tu BD/filestore (1200s ≈ 20 min suele bastar; aumenta si hace falta).
LIMIT_TIME_CPU=600
LIMIT_TIME_REAL=1200
LOG_LEVEL=info
LOG_HANDLER=:INFO
# LIST_DB debe ser True para ver y usar el gestor de bases de datos
# (/web/database/manager) donde se hace backup/duplicar/restaurar.
# En producción, protégelo por reverse proxy o vuélvelo a False cuando termines.
LIST_DB=False
WITHOUT_DEMO=all
PROXY_MODE=True

# -----------------------------------------------------------------------------
# PostgreSQL — tuning para operaciones de backup/restore/duplicado
#   DB_SHM_SIZE: tamaño de /dev/shm del contenedor de Postgres. El default de
#     Docker (64MB) provoca "could not resize shared memory segment" al
#     restaurar/duplicar BD grandes.
#   DB_MAX_CONNECTIONS: holgura sobre el default (100) de Postgres.
# -----------------------------------------------------------------------------
DB_SHM_SIZE=512mb
DB_MAX_CONNECTIONS=150

# -----------------------------------------------------------------------------
# First-run initialization
#   ODOO_INIT_MODULES: comma-separated modules to install on first boot.
#     For Colombian electronic invoice (l10n_co + xmlsig + DIAN flow), use:
#       ODOO_INIT_MODULES=base,l10n_co,l10n_co_edi
#     For PoS-only deployments leave it at 'base' and install modules from UI.
#   FORCE_RECONFIG: set to 1 once after changing any odoo.conf-related env var
#     to regenerate /var/lib/odoo/odoo.conf, then set back to 0.
# -----------------------------------------------------------------------------
ODOO_INIT_MODULES=base
FORCE_RECONFIG=0
